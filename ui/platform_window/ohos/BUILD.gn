component("ohos") {
  output_name = "ohos_window"

  deps = [
    "//base",
    "//skia",
    "//ui/base",
    "//ui/base/cursor",
    "//ui/events",
    "//ui/gfx",
    "//ui/gfx/geometry",
    "//ui/platform_window",
  ]

  defines = [ "OHOS_WINDOW_IMPLEMENTATION" ]

  sources = [
    "window.cc",
    "window.h",
    "window_export.h",
  ]
}
