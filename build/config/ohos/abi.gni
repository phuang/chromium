assert(is_ohos)

if (current_cpu == "x64") {
  ohos_abi_target = "x86_64-unknown-linux-ohos"
} else if (current_cpu == "arm64") {
  ohos_abi_target = "aarch64-unknown-linux-ohos"
} else if (current_cpu == "arm") {
  ohos_abi_target = "arm-unknown-linux-ohos"
} else {
  assert(false, "Unknown OHOS ABI: " + current_cpu)
}
